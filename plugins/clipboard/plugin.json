{
  "$schema": "https://z-tools.top/schema/plugin-v2.json",
  "schema": 2,
  "id": "com.ztools.clipboard",
  "name": "clipboard",
  "title": "剪贴板",
  "version": "1.0.2",
  "author": "ZTools-Tauri",
  "description": "外部剪贴板历史插件：搜索、粘贴（宿主写回剪贴板并按设置注入 Ctrl+V）与清空历史。剪贴板的监视、去重、裁剪与图片转换仍由宿主提供（插件只经 @ztools/sdk 调用）。",
  "logo": "logo.png",
  "runtime": {
    "type": "webview",
    "entry": "index.html"
  },
  "permissions": ["clipboard.read", "clipboard.write"],
  "features": [
    {
      "code": "clipboard.open",
      "label": "剪贴板",
      "cmds": []
    }
  ]
}
